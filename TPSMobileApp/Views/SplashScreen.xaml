<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TPSMobileApp.Views.SplashScreen"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:controls="clr-namespace:TPSMobileApp.Controls"
    Title="SplashScreen">
    <Grid
        BackgroundColor="White"
        HorizontalOptions="Fill"
        SafeAreaEdges="None"
        VerticalOptions="Fill">
       <ffimageloading:CachedImage 
            HorizontalOptions="Center"
            Source="logo.png"
            VerticalOptions="Center" />
    </Grid>
</ContentPage>